# Copia este archivo a .env y rellena los valores.
# NUNCA subas el .env real a ningún sitio: el token da control total del bot.

# Portal → tu app → Bot → Reset Token
DISCORD_TOKEN=

# Portal → tu app → General Information → Application ID
DISCORD_CLIENT_ID=

# Portal → tu app → OAuth2 → Client Secret (opcional, no lo usa el bot)
DISCORD_CLIENT_SECRET=

# ID de tu servidor (solo lo usa test/diagnostico.js)
DISCORD_GUILD_ID=
